# Template for .env on the DEV server (/data/stack/apps/time-4-action/mk-automation/.env on the dev VM).
# Never copy the production .env here: it holds the real T4A and CREAGLOBE keys.
#
# APP_ENV is deliberately NOT set: without APP_ENV=production the app refuses to start if any
# setting below points at production (main.metakocka.si, Better Stack).

API_KEY=

# Metakocka test system instead of main.metakocka.si
MK_BASE_URL=https://devmainsi.metakocka.si/rest/eshop

# T4A on devmainsi
MK_SECRET_KEY_T4A=
MK_COMPANY_ID_T4A=
MK_T4A_WAREHOUSE_ID=

# CREAGLOBE on devmainsi
MK_SECRET_KEY_CREAGLOBE=
MK_COMPANY_ID_CREAGLOBE=
MK_CREAGLOBE_WAREHOUSE_ID_T4A=
MK_CREAGLOBE_WAREHOUSE_ID_GERMANY_ONE=

# Leave empty in dev, or dev runs report as production runs.
BETTER_STACK_WH_SYNC_HEARTBEAT=
