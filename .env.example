# Only the production server sets this. Without it the app refuses to start if any setting
# below points at production (main.metakocka.si, Better Stack) — see docs/deployment.md.
APP_ENV=

# Metakocka REST base. Empty = config/config.json (main.metakocka.si, production only).
# Dev and laptops: https://devmainsi.metakocka.si/rest/eshop
MK_BASE_URL=

API_KEY=


# T4A MetaKocka credentials
MK_SECRET_KEY_T4A=
MK_COMPANY_ID_T4A=
MK_T4A_WAREHOUSE_ID=

# CREAGLOBE MetaKocka credentials
MK_SECRET_KEY_CREAGLOBE=
MK_COMPANY_ID_CREAGLOBE=
MK_CREAGLOBE_WAREHOUSE_ID_T4A=
MK_CREAGLOBE_WAREHOUSE_ID_GERMANY_ONE=

BETTER_STACK_WH_SYNC_HEARTBEAT=